{
  "manifest_version": 3,
  "name": "X Post to ChatGPT",
  "version": "0.1.0",
  "description": "表示中のX投稿をChatGPTデスクトップの新規チャットへ渡します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-post-to-chatgpt@yodaki.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["menus", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "X投稿をChatGPTへ",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
